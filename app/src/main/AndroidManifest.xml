<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online music (D-34, D-38): catalogue requests and artwork, https only (NetworkPolicy and the
         platform's cleartext switch agree since the user-server sources were retired). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Remote playback (YOUTUBE_MUSIC_ARCHITECTURE §8): Podium needs to see whether the app that
         plays online songs is installed, and to open it on a song. -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:name=".PodiumApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Podium"
        android:supportsRtl="true"
        android:theme="@style/Theme.Podium">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Signing in on the online service's own page (§6); never started from outside Podium. -->
        <activity
            android:name=".WebSignInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
